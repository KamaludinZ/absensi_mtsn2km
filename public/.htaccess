<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Selfie photos and supporting documents must only be served through
    # Laravel (routes selfies.show / documents.*), which check who is allowed
    # to see them. Block direct file access.
    RewriteRule ^storage/(selfies|permissions|attendance_corrections)/ - [F,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # IMPORTANT: Skip rewrite for static folders
    # DON'T skip rewrite for selfies - we need to validate access through Laravel
    RewriteCond %{REQUEST_URI} ^/build [NC,OR]
    RewriteCond %{REQUEST_URI} ^/storage [NC,OR]
    RewriteCond %{REQUEST_URI} ^/favicon\\.ico$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/favicon\\.svg$ [NC,OR]
    RewriteCond %{REQUEST_URI} ^/robots\\.txt$ [NC]
    RewriteRule .* - [L]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
