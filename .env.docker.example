# Variables for docker compose on your own computer (copy to .env).
# In Coolify, enter them on the "Environment Variables" page instead,
# see DEPLOY_COOLIFY.md.
APP_URL=http://localhost:8080
APP_PORT=8080
# Leave empty to generate one (kept in the storage volume), or copy the
# APP_KEY of an existing installation
APP_KEY=
DB_DATABASE=absensi
DB_USERNAME=absensi
DB_PASSWORD=ganti-dengan-password-kuat
# Only for a brand-new, empty database: creates user "admin" with this password
INITIAL_ADMIN_PASSWORD=
