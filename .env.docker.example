# Variables for docker compose (copy to .env). In Coolify, enter these in
# the app's "Environment Variables" page instead, see DEPLOY_COOLIFY.md.
APP_URL=http://localhost:8080
APP_PORT=8080
# Generate once with: docker compose run --rm app php artisan key:generate --show
APP_KEY=
DB_DATABASE=absensi
DB_USERNAME=absensi
DB_PASSWORD=ganti-dengan-password-kuat
# Only for a brand-new, empty database: creates user "admin" with this password
INITIAL_ADMIN_PASSWORD=
# Set to true when the site is served over HTTPS
SESSION_SECURE_COOKIE=false
