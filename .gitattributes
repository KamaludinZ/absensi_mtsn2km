# Set default behavior, in case people don't have core.autocrlf set.
* text=auto

#
# Selalu paksa file-file teks ini menggunakan format LF (Unix style)
#
*.php       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.vue       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.md        text eol=lf
*.sh        text eol=lf
*.bat       text eol=lf
*.py        text eol=lf
*.go        text eol=lf
*.txt       text eol=lf
*.html      text eol=lf
.env.example text eol=lf
.editorconfig text eol=lf
.styleci.yml text eol=lf
artisan     text eol=lf
composer.lock text eol=lf
package.json text eol=lf
package-lock.json text eol=lf

#
# Beri tahu Git bahwa file-file ini adalah binary dan jangan diubah
#
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.eot       binary
*.ttf       binary
*.woff      binary
*.woff2     binary
*.mp3       binary
*.mp